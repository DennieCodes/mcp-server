{
  "mcpServers": {
    "generic": {
      "command": "uv",
      "args": ["run", "generic_mcp.py"]
    },
    "desktop-commander": {
      "command": "npx",
      "args": ["-y", "@wonderwhy-er/desktop-commander"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--extension"]
    }
  }
}